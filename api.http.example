# REST API tests (VS Code "REST Client")
# All credentials come from the `.env` file next to this file.
# Run the "Login" call first: the returned JWT is reused automatically
# by the "Profile" calls below through the `# @name` variables.

## Variables
@host = http://localhost:{{$dotenv APP_PORT}}

@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}

@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}

@new_password = {{$dotenv NEW_PASSWORD}}

@register_username = {{$dotenv REGISTER_USERNAME}}
@register_email = {{$dotenv REGISTER_EMAIL}}
@register_password = {{$dotenv REGISTER_PASSWORD}}


## 1.Admin

### 1.1 Login
# Saves the token as `adminLogin` -> used by 1.4 automatically.
# @name adminLogin
POST {{host}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}


### 1.2 Register (admin) — one time only
# Works ONLY on a fresh database (no admin account yet).
# If an admin already exists -> 400 "You cannot register a new super admin" (expected).
# @name adminRegister
POST {{host}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "Example",
    "lastname": "Admin",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}


### 1.3 Forgot Password
# Returns 204. The reset token is emailed; no mail server is configured here,
# so read it from the DB instead (PGAdmin / psql):
#   SELECT reset_password_token FROM admin_users WHERE email = '{{admin_email}}';
POST {{host}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}


### 1.3.1 Reset Password
# Replace RESET_TOKEN with the value from the 1.3 e-mail / DB query above.
# @name adminResetPassword
POST {{host}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "RESET_TOKEN",
    "password": "{{new_password}}"
}


### 1.4 Profile
# Token is taken automatically from the 1.1 `adminLogin` response.
GET {{host}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


## 2.User

### 2.1 Login
# Saves the token as `userLogin` -> used by 2.4 automatically.
# @name userLogin
POST {{host}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}


### 2.2 Register (creates a NEW account — run once per account)
# If this email/username is already taken -> 400 (expected).
# After registering you can point USER_EMAIL / USER_PASSWORD in `.env`
# at {{register_email}} / {{register_password}} so 2.1 & 2.4 use the new account.
# @name userRegister
POST {{host}}/api/auth/local/register
Content-Type: application/json

{
    "username": "{{register_username}}",
    "email": "{{register_email}}",
    "password": "{{register_password}}"
}


### 2.3 Forgot Password
# No mail server is configured, so the code never arrives by e-mail.
# The code is written to the DB before sending, read it from PGAdmin / psql:
#   SELECT reset_password_token FROM up_users WHERE email = '{{user_email}}';
POST {{host}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}


### 2.3.1 Reset Password
# Replace RESET_CODE with the value from the 2.3 e-mail / DB query above.
# @name userResetPassword
POST {{host}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "RESET_CODE",
    "password": "{{new_password}}",
    "passwordConfirmation": "{{new_password}}"
}


### 2.3.2 Login After Reset Password
# Works once 2.3.1 has actually reset the password to {{new_password}}.
POST {{host}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{new_password}}"
}


### 2.4 Profile
# Token is taken automatically from the 2.1 `userLogin` response.
GET {{host}}/api/users/me
Authorization: Bearer {{userLogin.response.body.$.jwt}}


## 3.Content

# ทุก call ในหัวข้อนี้ต้อง login ก่อน — รัน 1.1 Admin Login ให้เสร็จก่อนเสมอ
# ใช้ token ของ admin เพราะ super admin ผ่าน permission ทุก content type
# ถ้าต้องการทดสอบด้วยสิทธิ์ของ user ให้เปลี่ยนเป็น {{userLogin.response.body.$.jwt}}
#
# Strapi ต้องห่อ body ด้วย "data" และ id ใน URL คือเลขที่ Strapi สร้างให้
# (ไม่ใช่ค่า studentId / subjectId / teacherId ที่เรากำหนดเอง)
# 3.x.3 และ 3.x.4 ดึง id จาก response ของ 3.x.1 ให้อัตโนมัติ
# ถ้าจะทดสอบกับ record ที่มีอยู่แล้ว ให้เปลี่ยนเป็น {{$dotenv STUDENT_ID}} / SUBJECT_ID / TEACHER_ID
#
# ถ้า content type เปิด Draft & Publish ให้เพิ่ม "publishedAt" ใน 3.x.1 เพื่อ publish ทันที
#
# Schema ที่ไฟล์นี้อ้างอิง (สร้างผ่าน Content-Type Builder — แก้ให้ตรงกับของจริง):
#   student  -> studentId(string), firstname(string), lastname(string), email(email), phone(string)
#   subject  -> subjectId(string), subjectName(string), credit(integer)
#   teacher  -> teacherId(string), firstname(string), lastname(string), email(email)


### 3.1 Student

#### 3.1.1 Create
# @name studentCreate
POST {{host}}/api/students
Authorization: Bearer {{adminLogin.response.body.$.data.token}}
Content-Type: application/json

{
    "data": {
        "studentId": "{{$dotenv STUDENT_ID}}",
        "firstname": "{{$dotenv STUDENT_FIRSTNAME}}",
        "lastname": "{{$dotenv STUDENT_LASTNAME}}",
        "email": "{{$dotenv STUDENT_EMAIL}}",
        "phone": "{{$dotenv STUDENT_PHONE}}"
    }
}


#### 3.1.2 List All
GET {{host}}/api/students
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


#### 3.1.3 List with ID
# ใช้ id ที่ได้จาก 3.1.1 — ถ้ายังไม่ได้รัน 3.1.1 ให้รัน 3.1.1 ก่อน
GET {{host}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


#### 3.1.4 Update
# PUT ส่งเฉพาะ field ที่ต้องการแก้ก็ได้ (partial update)
# @name studentUpdate
PUT {{host}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{adminLogin.response.body.$.data.token}}
Content-Type: application/json

{
    "data": {
        "firstname": "{{$dotenv STUDENT_UPDATE_FIRSTNAME}}",
        "phone": "{{$dotenv STUDENT_UPDATE_PHONE}}"
    }
}


### 3.2 Subject

#### 3.2.1 Create
# @name subjectCreate
POST {{host}}/api/subjects
Authorization: Bearer {{adminLogin.response.body.$.data.token}}
Content-Type: application/json

{
    "data": {
        "subjectId": "{{$dotenv SUBJECT_ID}}",
        "subjectName": "{{$dotenv SUBJECT_NAME}}",
        "credit": {{$dotenv SUBJECT_CREDIT}}
    }
}


#### 3.2.2 List All
GET {{host}}/api/subjects
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


#### 3.2.3 List with ID
# ใช้ id ที่ได้จาก 3.2.1 — ถ้ายังไม่ได้รัน 3.2.1 ให้รัน 3.2.1 ก่อน
GET {{host}}/api/subjects/{{subjectCreate.response.body.$.data.id}}
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


#### 3.2.4 Update
# PUT ส่งเฉพาะ field ที่ต้องการแก้ก็ได้ (partial update)
# @name subjectUpdate
PUT {{host}}/api/subjects/{{subjectCreate.response.body.$.data.id}}
Authorization: Bearer {{adminLogin.response.body.$.data.token}}
Content-Type: application/json

{
    "data": {
        "credit": {{$dotenv SUBJECT_UPDATE_CREDIT}}
    }
}


### 3.3 Teacher

#### 3.3.1 Create
# @name teacherCreate
POST {{host}}/api/teachers
Authorization: Bearer {{adminLogin.response.body.$.data.token}}
Content-Type: application/json

{
    "data": {
        "teacherId": "{{$dotenv TEACHER_ID}}",
        "firstname": "{{$dotenv TEACHER_FIRSTNAME}}",
        "lastname": "{{$dotenv TEACHER_LASTNAME}}",
        "email": "{{$dotenv TEACHER_EMAIL}}"
    }
}


#### 3.3.2 List All
GET {{host}}/api/teachers
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


#### 3.3.3 List with ID
# ใช้ id ที่ได้จาก 3.3.1 — ถ้ายังไม่ได้รัน 3.3.1 ให้รัน 3.3.1 ก่อน
GET {{host}}/api/teachers/{{teacherCreate.response.body.$.data.id}}
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


#### 3.3.4 Update
# PUT ส่งเฉพาะ field ที่ต้องการแก้ก็ได้ (partial update)
# @name teacherUpdate
PUT {{host}}/api/teachers/{{teacherCreate.response.body.$.data.id}}
Authorization: Bearer {{adminLogin.response.body.$.data.token}}
Content-Type: application/json

{
    "data": {
        "firstname": "{{$dotenv TEACHER_UPDATE_FIRSTNAME}}"
    }
}
# REST API tests (VS Code "REST Client")
# All credentials come from the `.env` file next to this file.
# Run the "Login" call first: the returned JWT is reused automatically
# by the "Profile" calls below through the `# @name` variables.
#
# API_PORT is the nginx reverse proxy, so the rate limiting in
# nginx/default.conf applies to these calls. Hitting APP_PORT directly
# (loopback) skips rate limiting.

## Variables
@host = http://localhost:{{$dotenv API_PORT}}

@admin_email = {{$dotenv ADMIN_EMAIL}}
@admin_password = {{$dotenv ADMIN_PASSWORD}}

@user_email = {{$dotenv USER_EMAIL}}
@user_password = {{$dotenv USER_PASSWORD}}

@new_password = {{$dotenv NEW_PASSWORD}}

@register_username = {{$dotenv REGISTER_USERNAME}}
@register_email = {{$dotenv REGISTER_EMAIL}}
@register_password = {{$dotenv REGISTER_PASSWORD}}


## 1.Admin

# ถ้าเป็นฐานข้อมูลใหม่ (ยังไม่เคยมี admin) ให้รัน 1.2 Register ก่อน แล้วค่อยกลับมารัน 1.1 Login
# ครั้งที่ 2 ขึ้นไป 1.1 Login จะได้ 200 ทันที แต่ 1.2 จะได้ 400 "You cannot register a new super admin" (ถูกต้อง)

### 1.1 Login
# Saves the token as `adminLogin` -> used by 1.4 automatically.
# @name adminLogin
POST {{host}}/admin/login
Content-Type: application/json

{
    "email": "{{admin_email}}",
    "password": "{{admin_password}}",
    "rememberMe": false
}


### 1.2 Register (admin) — one time only
# Works ONLY on a fresh database (no admin account yet).
# If an admin already exists -> 400 "You cannot register a new super admin" (expected).
# @name adminRegister
POST {{host}}/admin/register-admin
Content-Type: application/json

{
    "firstname": "Example",
    "lastname": "Admin",
    "email": "{{admin_email}}",
    "password": "{{admin_password}}"
}


### 1.3 Forgot Password
# Returns 204. The reset token is emailed; no mail server is configured here,
# so read it from the DB instead (PGAdmin / psql):
#   SELECT reset_password_token FROM admin_users WHERE email = '{{admin_email}}';
POST {{host}}/admin/forgot-password
Content-Type: application/json

{
    "email": "{{admin_email}}"
}


### 1.3.1 Reset Password
# Replace RESET_TOKEN with the value from the 1.3 e-mail / DB query above.
# @name adminResetPassword
POST {{host}}/admin/reset-password
Content-Type: application/json

{
    "resetPasswordToken": "RESET_TOKEN",
    "password": "{{new_password}}"
}


### 1.4 Profile
# Token is taken automatically from the 1.1 `adminLogin` response.
GET {{host}}/admin/users/me
Authorization: Bearer {{adminLogin.response.body.$.data.token}}


## 2.User

# ถ้ายังไม่มี user account นี้ ให้รัน 2.2 Register ก่อน แล้วค่อยรัน 2.1 Login
# 2.1 จะได้ 400 "Invalid identifier or password" จนกว่าจะมี account แล้ว
# 2.3.1 / 2.3.2 ต้องใส่ reset code จริงที่รับจากอีเมล ถ้าไม่ใส่จะได้ 400 ตามปกติ
# ดังนั้น 2.4 Profile จะได้ 401 ถ้า 2.1 Login ยังไม่สำเร็จ
#
# ข้อจำกัดที่ต้องรู้: ยังไม่ได้ตั้ง SMTP ในโปรเจกต์นี้ Strapi จึงส่งอีเมลไม่ได้
#   - 1.3 / 2.3 (forgot-password) จะได้ 504 ภายใน 10 วินาที (nginx ตัดเวลาไว้แล้ว
#     เพื่อไม่ให้ค้างนาน) ถ้าจะให้สำเร็จต้องตั้งค่า SMTP ใน .env ของ Strapi
#   - 2.3.1 / 2.3.2 จึงยังทำต่อไม่ได้ เพราะไม่มี reset code
#   ส่วนหัวข้อ 3 ไม่เกี่ยวกับอีเมล จึงใช้งานได้ครบทั้ง 12 call

### 2.1 Login
# Saves the token as `userLogin` -> used by 2.4 automatically.
# @name userLogin
POST {{host}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{user_password}}"
}


### 2.2 Register (creates a NEW account — run once per account)
# If this email/username is already taken -> 400 (expected).
# After registering you can point USER_EMAIL / USER_PASSWORD in `.env`
# at {{register_email}} / {{register_password}} so 2.1 & 2.4 use the new account.
# @name userRegister
POST {{host}}/api/auth/local/register
Content-Type: application/json

{
    "username": "{{register_username}}",
    "email": "{{register_email}}",
    "password": "{{register_password}}"
}


### 2.3 Forgot Password
# No mail server is configured, so the code never arrives by e-mail.
# The code is written to the DB before sending, read it from PGAdmin / psql:
#   SELECT reset_password_token FROM up_users WHERE email = '{{user_email}}';
POST {{host}}/api/auth/forgot-password
Content-Type: application/json

{
    "email": "{{user_email}}"
}


### 2.3.1 Reset Password
# Replace RESET_CODE with the value from the 2.3 e-mail / DB query above.
# @name userResetPassword
POST {{host}}/api/auth/reset-password
Content-Type: application/json

{
    "code": "RESET_CODE",
    "password": "{{new_password}}",
    "passwordConfirmation": "{{new_password}}"
}


### 2.3.2 Login After Reset Password
# Works once 2.3.1 has actually reset the password to {{new_password}}.
POST {{host}}/api/auth/local
Content-Type: application/json

{
    "identifier": "{{user_email}}",
    "password": "{{new_password}}"
}


### 2.4 Profile
# Token is taken automatically from the 2.1 `userLogin` response.
GET {{host}}/api/users/me
Authorization: Bearer {{userLogin.response.body.$.jwt}}


## 3.Content

# Content API ของ Strapi ไม่รับ admin JWT (ตอบ 401) และไม่รับ user JWT
# ถ้า role นั้นไม่มี permission (ตอบ 403) — ต้องใช้ API token แบบ Full access
# ไฟล์นี้สร้างให้เองอัตโนมัติที่ Prereq.1 ด้านล่าง ไม่ต้องแก้ .env
# ทุก call ในหัวข้อนี้จะใช้ token ตัวเดียวกันที่สร้างในขั้นตอนนั้น
# ถ้าได้ 401/403 แปลว่ายังไม่ได้รัน Prereq.1 หรือ admin login ไม่สำเร็จ
#
# request body ต้องห่อด้วย "data" และ id ใน URL คือเลขที่ Strapi สร้างให้
# 3.x.3 และ 3.x.4 ดึง id จาก response ของ 3.x.1 ให้อัตโนมัติ
#
# ทุก content type เปิด Draft & Publish — record ที่สร้างใหม่จะเป็น draft
# (admin token มองเห็น draft ได้, user token มองไม่เห็น)
# ถ้าต้องการ publish ทันทีให้เพิ่ม "publishedAt": "2026-01-01T00:00:00.000Z" ใน 3.x.1
#
# Fields ตาม Content-Type Builder (ทดสอบกับ API จริงแล้ว):
#   student -> name(string), mobile(encrypted), cardId(string)
#   subject -> name(string)
#   teacher -> name(string)
#
# ข้อควรระวังตอนรัน:
#   - student.cardId  unique และยาว Exactly 13 ตัวอักษร (ความยาวบัตรประชาชน)
#     ถ้าใส่ไม่ครบ 13 จะได้ 400 "cardId must be at least/most 13 characters"
#   - subject.name    unique  -> ถ้าใส่ซ้ำจะได้ 400 "This attribute must be unique"
#   - teacher.name    ไม่ unique -> สร้างซ้ำได้
#   - student.mobile  เป็น encrypted field -> ตอนอ่านกลับ (3.1.2 / 3.1.3)
#     จะได้ค่าเป็น ciphertext 32 หลัก hex ไม่ใช่เบอร์ที่ส่งเข้าไป (ถ้าต้องการเทียบค่าให้ดู 3.1.4)
#   - ผลของ Create ที่ unique (3.1.1 / 3.2.1) รันซ้ำไม่ได้ เหมือน 1.2 / 2.2
#     ถ้าต้องการทดสอบซ้ำให้เปลี่ยนค่าใน .env แล้วรันใหม่


### Prereq.1 Create API Token (Full access)
# ขั้นตอนก่อนใช้หัวข้อ 3.1-3.3 — ไม่ใช่ส่วนที่มอบหมาย
# ใช้ admin JWT จาก 1.1 Login แล้วเก็บ accessKey ไว้ให้ทุก call ในหัวข้อ 3 ใช้เอง
# ชื่อ token มีเลขสุ่มต่อท้าย เพื่อให้รันซ้ำได้โดยไม่ชน "Name already taken"
# lifespan = 604800000 ms (7 วัน) — full-access ที่ไม่มีวันหมดอายุเป็นความเสี่ยง
#   ค่าที่ Strapi รับได้: null | 604800000 (7 วัน) | 2592000000 (30 วัน) | 7776000000 (90 วัน)
# เมื่อหมดอายุ หัวข้อ 3 จะได้ 401 ให้รัน Prereq.1 ใหม่เพื่อออก token ใหม่
# accessKey จะแสดงครั้งเดียวตอนสร้างเท่านั้น ถ้าทำหายต้องสร้างใหม่
# @name contentApiToken
POST {{host}}/admin/api-tokens
Content-Type: application/json
Authorization: Bearer {{adminLogin.response.body.$.data.token}}

{
    "name": "rest-client-{{$randomInt 1000 9999}}",
    "description": "auto-created by api.http for section 3",
    "type": "full-access",
    "lifespan": 604800000
}


### 3.1 Student

#### 3.1.1 Create
# cardId ต้องครบ 13 หลักและห้ามซ้ำ
# @name studentCreate
POST {{host}}/api/students
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv STUDENT_NAME}}",
        "mobile": "{{$dotenv STUDENT_MOBILE}}",
        "cardId": "{{$dotenv STUDENT_CARD_ID}}"
    }
}


#### 3.1.2 List All
# mobile ที่ได้กลับมาเป็น ciphertext เพราะเป็น encrypted field
GET {{host}}/api/students
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}


#### 3.1.3 List with ID
# ใช้ id ที่ได้จาก 3.1.1 — ถ้ายังไม่ได้รัน 3.1.1 ให้รัน 3.1.1 ก่อน
GET {{host}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}


#### 3.1.4 Update
# PUT ส่งเฉพาะ field ที่ต้องการแก้ก็ได้ (partial update)
# @name studentUpdate
PUT {{host}}/api/students/{{studentCreate.response.body.$.data.id}}
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv STUDENT_UPDATE_NAME}}",
        "mobile": "{{$dotenv STUDENT_UPDATE_MOBILE}}"
    }
}


### 3.2 Subject

#### 3.2.1 Create
# name ห้ามซ้ำกับ record ที่มีอยู่
# @name subjectCreate
POST {{host}}/api/subjects
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv SUBJECT_NAME}}"
    }
}


#### 3.2.2 List All
GET {{host}}/api/subjects
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}


#### 3.2.3 List with ID
# ใช้ id ที่ได้จาก 3.2.1 — ถ้ายังไม่ได้รัน 3.2.1 ให้รัน 3.2.1 ก่อน
GET {{host}}/api/subjects/{{subjectCreate.response.body.$.data.id}}
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}


#### 3.2.4 Update
# PUT ส่งเฉพาะ field ที่ต้องการแก้ก็ได้ (partial update)
# @name subjectUpdate
PUT {{host}}/api/subjects/{{subjectCreate.response.body.$.data.id}}
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv SUBJECT_UPDATE_NAME}}"
    }
}


### 3.3 Teacher

#### 3.3.1 Create
# @name teacherCreate
POST {{host}}/api/teachers
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv TEACHER_NAME}}"
    }
}


#### 3.3.2 List All
GET {{host}}/api/teachers
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}


#### 3.3.3 List with ID
# ใช้ id ที่ได้จาก 3.3.1 — ถ้ายังไม่ได้รัน 3.3.1 ให้รัน 3.3.1 ก่อน
GET {{host}}/api/teachers/{{teacherCreate.response.body.$.data.id}}
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}


#### 3.3.4 Update
# PUT ส่งเฉพาะ field ที่ต้องการแก้ก็ได้ (partial update)
# @name teacherUpdate
PUT {{host}}/api/teachers/{{teacherCreate.response.body.$.data.id}}
Authorization: Bearer {{contentApiToken.response.body.$.data.accessKey}}
Content-Type: application/json

{
    "data": {
        "name": "{{$dotenv TEACHER_UPDATE_NAME}}"
    }
}

POSTGRES_USER=example_user
POSTGRES_PASSWORD=ExamplePostgresPassword123
POSTGRES_DB=example_database
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=ExamplePgAdminPassword123
PGADMIN_DEFAULT_PORT=8082

# Strapi uses a dedicated least-privilege DB account (different from the Postgres superuser)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=example_database
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=ExampleStrapiDatabasePassword123

# Direct Strapi port — bound to 127.0.0.1 only, for debugging.
# Rate limiting does NOT apply here; use API_PORT for anything real.
APP_PORT=9092

# Public entrypoint: nginx reverse proxy (the only port bound to all interfaces).
# api.http and the browser both use this port.
# NOTE: /admin is also reachable through this port, so anyone on the network can
# reach the Strapi admin panel. To keep it local-only, bind it on loopback in
# docker-compose.yaml -> ports: - "127.0.0.1:${API_PORT}:80"
API_PORT=80

# REST Client credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ExampleAdminPassword123

USER_EMAIL=user@example.com
USER_PASSWORD=ExampleUserPassword123

NEW_PASSWORD=ExampleNewPassword123

# New account created by the user-register call (2.2)
REGISTER_USERNAME=example-test
REGISTER_EMAIL=example-test@example.com
REGISTER_PASSWORD=ExampleRegisterPassword123

# Content API token for section 3.
# Strapi's Content API does NOT accept the admin JWT (401) nor the user JWT
# unless that role has permissions (403). Create a token once via either:
#   Admin panel -> Settings -> API Tokens -> Create API Token -> Full access
#   or: curl -X POST http://localhost:<API_PORT>/admin/api-tokens \
#          -H "Authorization: Bearer <ADMIN_TOKEN>" -H 'Content-Type: application/json' \
#          -d '{"name":"rest-client","type":"full-access","lifespan":null}'
#     lifespan ต้องเป็น null หรือ 604800000 (7 วัน) / 2592000000 (30 วัน) / 7776000000 (90 วัน)
#     ค่าที่ได้จาก response คือ data.accessKey -> เอาไปวางที่ API_TOKEN ด้านล่าง
#     (accessKey จะแสดงครั้งเดียวตอนสร้างเท่านั้น)
API_TOKEN=replace_with_strapi_api_token

# Content (3.1 Student) — fields: name, mobile, cardId
#   cardId : unique, exactly 13 characters (national ID length)
#   mobile : encrypted field -> returns ciphertext, not plaintext
STUDENT_NAME=Example Student
STUDENT_MOBILE=0800000000
STUDENT_CARD_ID=1234567890123
STUDENT_UPDATE_NAME=Example Student Updated
STUDENT_UPDATE_MOBILE=0899999999

# Content (3.2 Subject) — fields: name (unique)
SUBJECT_NAME=Introduction to Cyber Security
SUBJECT_UPDATE_NAME=Introduction to Cyber Security (Revised)

# Content (3.3 Teacher) — fields: name
TEACHER_NAME=Example Teacher
TEACHER_UPDATE_NAME=Example Teacher Updated

# Unique per-service secrets (openssl rand -hex 32) — never share between services
APP_KEYS=example_app_keys_replace_with_random_secret
API_TOKEN_SALT=example_api_token_salt_replace_with_random_secret
ADMIN_JWT_SECRET=example_admin_jwt_secret_replace_with_random_secret
JWT_SECRET=example_jwt_secret_replace_with_random_secret
TRANSFER_TOKEN_SALT=example_transfer_token_salt_replace_with_random_secret

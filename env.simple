POSTGRES_USER=example_user
POSTGRES_PASSWORD=ExamplePostgresPassword123
POSTGRES_DB=example_database
POSTGRES_PORT=5432

PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=ExamplePgAdminPassword123
PGADMIN_DEFAULT_PORT=8082

# Strapi uses a dedicated least-privilege DB account (different from the Postgres superuser)
DATABASE_HOST=db
DATABASE_PORT=5432
DATABASE_NAME=example_database
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=ExampleStrapiDatabasePassword123

APP_PORT=9092

# REST Client credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ExampleAdminPassword123

USER_EMAIL=user@example.com
USER_PASSWORD=ExampleUserPassword123

NEW_PASSWORD=ExampleNewPassword123

# New account created by the user-register call (2.2)
REGISTER_USERNAME=example-test
REGISTER_EMAIL=example-test@example.com
REGISTER_PASSWORD=ExampleRegisterPassword123

# Unique per-service secrets (openssl rand -hex 32) — never share between services
APP_KEYS=example_app_keys_replace_with_random_secret
API_TOKEN_SALT=example_api_token_salt_replace_with_random_secret
ADMIN_JWT_SECRET=example_admin_jwt_secret_replace_with_random_secret
JWT_SECRET=example_jwt_secret_replace_with_random_secret
TRANSFER_TOKEN_SALT=example_transfer_token_salt_replace_with_random_secret
